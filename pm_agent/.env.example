# Copy to pm_agent/.env and fill in. adk web / adk run load this file automatically.

# Option A — Gemini API key from https://aistudio.google.com (simplest for local development)
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your-key-here

# Option B — Vertex AI (switch to this later; no code changes needed)
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# Optional tuning (defaults in pm_agent/config.py)
# PM_MODEL=gemini-3.6-flash
# DEV_MODEL=            # defaults to PM_MODEL
# PM_MAX_QUESTIONS=5
# PM_COMPACTION_TOKENS=60000
# PM_COMPACTION_KEEP_EVENTS=20

# Option C — NVIDIA (free dev tier, https://build.nvidia.com). Any PM_MODEL containing '/'
# is sent to NVIDIA's OpenAI-compatible endpoint instead of Gemini.
# PM_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# NVIDIA_API_KEY=nvapi-your-key-here
# NVIDIA_THINKING=true

# Dev agent file sandbox (Phase 2.5). Needs Node.js 22+ and npx on PATH.
# AGENTCORP_WORKSPACE=D:/path/to/workspace     # default: <repo>/workspace
# AGENTCORP_MCP_TIMEOUT=60                     # seconds to start the MCP server (first run downloads it)
